# --- LLM used by inference.py (OpenAI-compatible endpoint) ---
API_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct
# Hugging Face token (https://huggingface.co/settings/tokens) or any key for API_BASE_URL
HF_TOKEN=your_token_here

# --- Optional ---
# Environment server; leave empty to run the environment in-process
ENV_URL=
# "llm" (default when a token is set) or "heuristic"
AGENT=llm
EPISODES_PER_TASK=3
MAX_WORKERS=3
